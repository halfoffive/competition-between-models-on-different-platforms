{
  "name": "voxelcraft",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Minecraft-like voxel game built with Vite + Vue 3 + Three.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "vue": "^3.4.38",
    "pinia": "^2.2.2",
    "three": "^0.168.0",
    "simplex-noise": "^4.0.3"
  },
  "devDependencies": {
    "@types/three": "^0.168.0",
    "@types/node": "^22.5.5",
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vue-tsc": "^2.1.6"
  }
}
